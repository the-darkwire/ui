{
  "name": "@the-darkwire/ui",
  "version": "0.1.0",
  "description": "the-darkwire org's shared UI library: React Native primitives + design tokens. Runs natively on mobile and via React Native Web on web.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tailwind-preset": "./src/theme/tailwind-preset.cjs"
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "nativewind": "^4.0.0",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-web": ">=0.19",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/react": "^18.3.0",
    "nativewind": "^4.0.0",
    "react": "^18.3.0",
    "react-native": "^0.76.0",
    "react-native-web": "^0.19.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.3.0"
}
